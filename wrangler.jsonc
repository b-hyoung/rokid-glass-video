{
  "name": "glass-2412",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/control", "/control/", "/server.txt", "/recognition", "/recognition/*", "/status", "/play", "/stop", "/next", "/log", "/cam", "/cam/*", "/frame", "/stream", "/tele"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {"bindings": [{"name":"ROOM", "class_name":"GlassRoom"}]},
  "migrations": [{"tag":"v1", "new_sqlite_classes":["GlassRoom"]}]
}
