{
  "name": "rokid-original-baseline",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "containers": [{
    "class_name": "OriginalServer",
    "image": "./Dockerfile",
    "image_build_context": ".",
    "instance_type": "standard-2",
    "max_instances": 1
  }],
  "durable_objects": {"bindings": [{"name": "ORIGINAL", "class_name": "OriginalServer"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["OriginalServer"]}]
}
